{
  "manifest_version": 3,
  "name": "FlashGuard",
  "version": "0.1.0",
  "description": "Detects hazardous flashing in web video and dims/blurs it in real time. Not a medical device.",
  "minimum_chrome_version": "110",

  "permissions": ["storage"],

  "background": {
    "service_worker": "background/service-worker.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle",
      "js": ["content/index.js"]
    }
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "FlashGuard"
  },

  "options_page": "options/options.html"
}
